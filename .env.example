# Copy this file to .env and fill in your key. Never commit .env.
#
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Book 2 (AI That Reads) uses a Postgres + pgvector container from docker-compose.
# These defaults match that container; change them only if you point at your own database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_in_typescript

# Copy this file to .env and fill in your keys. Never commit .env.
#
# One .env at the repository root serves every book: each book's
# `npm run run-example` reads ../.env first and then its own .env.

# The answering model, every book.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Book 2 (AI That Reads) only. The embedding model, from chapter 2 onward.
# A different vendor from the answering model, because the vendor behind
# claude-sonnet-5 does not sell an embeddings endpoint.
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=

# Book 2 only. The reranker, from chapter 9 onward.
# Get a key at https://dashboard.cohere.com/
COHERE_API_KEY=

# Book 2 only. Postgres with pgvector, from chapter 7 onward. Started by
# `docker compose up -d` in ai-that-reads/, and these are that container's
# credentials — change them only if you point at your own database.
DATABASE_URL=postgresql://braxby:braxby@localhost:5432/braxby

# Book 2 only. Qdrant, chapter 7's second store path. Optional: the listings
# fall back to this exact value when it is unset.
QDRANT_URL=http://localhost:6333

# Book 4 (AI That Plans) only. The Postgres the checkpointer writes to, from
# chapter 6 onward. Started by `docker compose up -d` in ai-that-plans/, and
# these are that container's credentials.
#
# Port 5433, not 5432: Book 2 publishes its own Postgres on 5432, and a reader
# with both stacks up should not have to debug a port collision. Optional — the
# listings fall back to this exact value when it is unset.
PLANS_DATABASE_URL=postgresql://braxby:braxby@localhost:5433/braxby

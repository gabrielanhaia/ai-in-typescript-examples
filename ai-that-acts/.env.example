# Copy to .env, here or in the repository root, and fill in your own values.
# `npm run run-example` reads ../.env and then .env, so either works and the
# root one serves every book. Both are git-ignored. No value in this file is
# a credential, and no listing in this book ever prints one.

# The model every listing in this book runs on.
ANTHROPIC_API_KEY=

# Where the sample Braxby service is answering. Left empty on purpose: the
# code falls back to http://localhost:8788, which is what `docker compose
# up -d` in this directory publishes. Set it only if you moved the service.
BRAXBY_API_URL=

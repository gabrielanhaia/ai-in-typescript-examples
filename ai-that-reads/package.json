{
  "name": "ai-that-reads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable examples for AI That Reads (Book 2 of AI in TypeScript)",
  "license": "MIT",
  "scripts": {
    "run-example": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx scripts/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@langchain/classic": "1.0.40",
    "@langchain/cohere": "1.1.0",
    "@langchain/core": "1.2.3",
    "@langchain/openai": "1.5.5",
    "@langchain/pgvector": "0.1.0",
    "@langchain/qdrant": "1.0.3",
    "@langchain/textsplitters": "1.0.1",
    "@qdrant/js-client-rest": "1.18.0",
    "cheerio": "1.2.0",
    "langchain": "1.5.4",
    "openai": "6.49.0",
    "pdf-parse": "2.4.5",
    "pg": "8.22.0",
    "pgvector": "0.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

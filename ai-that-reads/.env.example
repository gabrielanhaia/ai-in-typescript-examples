# Copy to .env, here or in the repository root, and fill in your own values.
# `npm run run-example` reads ../.env and then .env, so either works and the
# root one serves every book. Both are git-ignored. No value in this file is
# a credential, and no listing in this book ever prints one.

# The answering model. Chapters 1, 2, 10 and 14.
ANTHROPIC_API_KEY=

# The embedding model. Chapters 2, 4, 5, 6, 7, 8, 12, 13 and 14.
# A different vendor from the answering model, because the vendor behind
# claude-sonnet-5 does not sell an embeddings endpoint — chapter 5.
OPENAI_API_KEY=

# The reranker. Chapters 9, 10, 12 and 14.
COHERE_API_KEY=

# Postgres with pgvector, from chapter 7 onward. This value matches the
# container in this directory's docker-compose.yml; change it only if you are
# pointing at your own database.
DATABASE_URL=postgresql://braxby:braxby@localhost:5432/braxby

# Qdrant, chapter 7's second path and chapter 14's migration. Optional: the
# listings fall back to this exact value when it is unset.
QDRANT_URL=http://localhost:6333

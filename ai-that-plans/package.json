{
  "name": "ai-that-plans",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable code listings from AI That Plans (Book 4 of AI in TypeScript).",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "run-example": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx scripts/run.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@hono/node-server": "2.0.11",
    "@langchain/anthropic": "1.5.2",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.3",
    "@langchain/langgraph-supervisor": "1.1.1",
    "@langchain/langgraph-swarm": "1.0.2",
    "hono": "4.12.32",
    "langchain": "1.5.4",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
